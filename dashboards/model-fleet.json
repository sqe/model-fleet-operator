{
  "annotations":{"list":[]},
  "description":"Unified resource, workload, network, model-usage, and cost view for Model Fleet.",
  "editable":true,
  "graphTooltip":1,
  "links":[],
  "panels":[
    {"type":"row","title":"Compute and accelerator utilization","collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":0},"panels":[]},
    {"type":"timeseries","title":"Workload CPU usage","description":"CPU cores consumed by matching pods.","gridPos":{"h":8,"w":12,"x":0,"y":1},"fieldConfig":{"defaults":{"unit":"cores"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$workload\",container!=\"\",image!=\"\"}[$__rate_interval])) by (pod)","legendFormat":"{{pod}}"}]},
    {"type":"timeseries","title":"Workload memory working set","description":"Memory currently charged to matching workload containers.","gridPos":{"h":8,"w":12,"x":12,"y":1},"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$workload\",container!=\"\",image!=\"\"}) by (pod)","legendFormat":"{{pod}}"}]},
    {"type":"timeseries","title":"NVIDIA GPU utilization","description":"Requires NVIDIA dcgm-exporter with Kubernetes pod labels.","gridPos":{"h":8,"w":8,"x":0,"y":9},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]},"targets":[{"refId":"A","expr":"avg(DCGM_FI_DEV_GPU_UTIL{namespace=~\"$namespace\",pod=~\"$workload\"}) by (pod, gpu)","legendFormat":"{{pod}} GPU {{gpu}}"}]},
    {"type":"timeseries","title":"NVIDIA framebuffer memory used","description":"Requires NVIDIA dcgm-exporter.","gridPos":{"h":8,"w":8,"x":8,"y":9},"fieldConfig":{"defaults":{"unit":"decmbytes"},"overrides":[]},"targets":[{"refId":"A","expr":"DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\",pod=~\"$workload\"}","legendFormat":"{{pod}} GPU {{gpu}}"}]},
    {"type":"timeseries","title":"NVIDIA GPU power","description":"Requires NVIDIA dcgm-exporter.","gridPos":{"h":8,"w":8,"x":16,"y":9},"fieldConfig":{"defaults":{"unit":"watt"},"overrides":[]},"targets":[{"refId":"A","expr":"DCGM_FI_DEV_POWER_USAGE{namespace=~\"$namespace\",pod=~\"$workload\"}","legendFormat":"{{pod}} GPU {{gpu}}"}]},
    {"type":"timeseries","title":"Requested resource utilization","description":"CPU and memory use as a percentage of Kubernetes requests. Values above 100% indicate use beyond the requested reservation.","gridPos":{"h":8,"w":24,"x":0,"y":17},"fieldConfig":{"defaults":{"unit":"percent","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"100 * sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$workload\",container!=\"\",image!=\"\"}[$__rate_interval])) / clamp_min(sum(kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$workload\",resource=\"cpu\"}), 0.001)","legendFormat":"CPU used / requested"},{"refId":"B","expr":"100 * sum(container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$workload\",container!=\"\",image!=\"\"}) / clamp_min(sum(kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$workload\",resource=\"memory\"}), 1)","legendFormat":"Memory used / requested"}]},
    {"type":"row","title":"Inference, training, scaling, and storage","collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":25},"panels":[]},
    {"type":"timeseries","title":"Inference replicas","description":"Available and desired Deployment replicas for selected inference workloads. Requires kube-state-metrics.","gridPos":{"h":8,"w":12,"x":0,"y":26},"fieldConfig":{"defaults":{"unit":"short","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"kube_deployment_status_replicas_available{namespace=~\"$namespace\",deployment=~\"$workload\"}","legendFormat":"{{deployment}} available"},{"refId":"B","expr":"kube_deployment_spec_replicas{namespace=~\"$namespace\",deployment=~\"$workload\"}","legendFormat":"{{deployment}} desired"}]},
    {"type":"timeseries","title":"KEDA / HPA scaling","description":"Desired/current HPA replicas plus KEDA external metric value when KEDA metrics are exposed.","gridPos":{"h":8,"w":12,"x":12,"y":26},"fieldConfig":{"defaults":{"unit":"short","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"kube_horizontalpodautoscaler_status_desired_replicas{namespace=~\"$namespace\",horizontalpodautoscaler=~\"$workload\"}","legendFormat":"{{horizontalpodautoscaler}} desired"},{"refId":"B","expr":"kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\",horizontalpodautoscaler=~\"$workload\"}","legendFormat":"{{horizontalpodautoscaler}} current"},{"refId":"C","expr":"keda_scaler_metrics_value{namespace=~\"$namespace\",scaledObject=~\"$workload\"}","legendFormat":"{{scaledObject}} trigger"}]},
    {"type":"timeseries","title":"Training Job state","description":"Active, succeeded, and failed Kubernetes training Jobs. Requires kube-state-metrics.","gridPos":{"h":8,"w":12,"x":0,"y":34},"fieldConfig":{"defaults":{"unit":"short","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"kube_job_status_active{namespace=~\"$namespace\",job_name=~\"$workload\"}","legendFormat":"{{job_name}} active"},{"refId":"B","expr":"kube_job_status_succeeded{namespace=~\"$namespace\",job_name=~\"$workload\"}","legendFormat":"{{job_name}} succeeded"},{"refId":"C","expr":"kube_job_status_failed{namespace=~\"$namespace\",job_name=~\"$workload\"}","legendFormat":"{{job_name}} failed"}]},
    {"type":"timeseries","title":"PVC storage used","description":"Kubelet volume stats; absent for drivers that do not publish volume statistics.","gridPos":{"h":8,"w":12,"x":12,"y":34},"fieldConfig":{"defaults":{"unit":"bytes","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"kubelet_volume_stats_used_bytes{namespace=~\"$namespace\",persistentvolumeclaim=~\"$workload\"}","legendFormat":"{{persistentvolumeclaim}} used"},{"refId":"B","expr":"kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\",persistentvolumeclaim=~\"$workload\"}","legendFormat":"{{persistentvolumeclaim}} capacity"}]},
    {"type":"row","title":"Messaging and model economics","collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":42},"panels":[]},
    {"type":"timeseries","title":"Kafka consumer lag","description":"Requires kafka-exporter and the documented kafka_consumergroup_lag metric.","gridPos":{"h":8,"w":12,"x":0,"y":43},"fieldConfig":{"defaults":{"unit":"short","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"sum(kafka_consumergroup_lag{consumergroup=~\"$consumer_group\"}) by (consumergroup, topic)","legendFormat":"{{consumergroup}} / {{topic}}"}]},
    {"type":"timeseries","title":"Model token rate","description":"Model Fleet custom counter model_fleet_tokens_total, split by input/output direction.","gridPos":{"h":8,"w":12,"x":12,"y":43},"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(model_fleet_tokens_total{namespace=~\"$namespace\",workload=~\"$workload\"}[$__rate_interval])) by (model, direction)","legendFormat":"{{model}} {{direction}} tokens/s"}]},
    {"type":"timeseries","title":"Inference cost and cost per token","description":"Model Fleet counters model_fleet_inference_cost_usd_total and model_fleet_tokens_total. Ratios are estimated accounting cost, not billing truth.","gridPos":{"h":8,"w":12,"x":0,"y":51},"fieldConfig":{"defaults":{},"overrides":[{"matcher":{"id":"byName","options":"USD/s"},"properties":[{"id":"unit","value":"currencyUSD"}]},{"matcher":{"id":"byName","options":"USD/token"},"properties":[{"id":"unit","value":"currencyUSD"}]}]},"targets":[{"refId":"A","expr":"sum(rate(model_fleet_inference_cost_usd_total{namespace=~\"$namespace\",workload=~\"$workload\"}[$__rate_interval]))","legendFormat":"USD/s"},{"refId":"B","expr":"sum(rate(model_fleet_inference_cost_usd_total{namespace=~\"$namespace\",workload=~\"$workload\"}[$__rate_interval])) / clamp_min(sum(rate(model_fleet_tokens_total{namespace=~\"$namespace\",workload=~\"$workload\"}[$__rate_interval])), 1e-9)","legendFormat":"USD/token"}]},
    {"type":"timeseries","title":"Allocated node cost","description":"Approximate hourly node cost for nodes running selected pods; requires OpenCost node_total_hourly_cost and kube-state-metrics.","gridPos":{"h":8,"w":12,"x":12,"y":51},"fieldConfig":{"defaults":{"unit":"currencyUSD"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (node) (node_total_hourly_cost * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$workload\"}) > 0))","legendFormat":"{{node}} USD/hour"}]},
    {"type":"row","title":"Cilium and Hubble network observability","collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":59},"panels":[]},
    {"type":"timeseries","title":"Hubble HTTP request rate","description":"End-to-end HTTP requests observed by Cilium, grouped by source, destination, method, and status.","gridPos":{"h":8,"w":8,"x":0,"y":60},"fieldConfig":{"defaults":{"unit":"reqps","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(hubble_http_requests_total{destination_namespace=~\"$namespace\",destination_workload=~\"$workload\"}[$__rate_interval])) by (source_workload, destination_workload, method, status)","legendFormat":"{{source_workload}} → {{destination_workload}} {{method}} {{status}}"}]},
    {"type":"timeseries","title":"Hubble network drops","description":"Dropped packets observed by Cilium for selected destination workloads, grouped by reason.","gridPos":{"h":8,"w":8,"x":8,"y":60},"fieldConfig":{"defaults":{"unit":"pps","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(hubble_drop_total{destination_namespace=~\"$namespace\",destination_workload=~\"$workload\"}[$__rate_interval])) by (source_workload, destination_workload, reason)","legendFormat":"{{source_workload}} → {{destination_workload}}: {{reason}}"}]},
    {"type":"timeseries","title":"Hubble DNS and TCP activity","description":"DNS queries and TCP flags emitted by selected workloads; use with HTTP and drop panels to trace a request path.","gridPos":{"h":8,"w":8,"x":16,"y":60},"fieldConfig":{"defaults":{"unit":"ops","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(hubble_dns_queries_total{source_namespace=~\"$namespace\",source_workload=~\"$workload\"}[$__rate_interval])) by (source_workload, destination_workload, qtypes)","legendFormat":"DNS {{source_workload}} → {{destination_workload}} {{qtypes}}"},{"refId":"B","expr":"sum(rate(hubble_tcp_flags_total{source_namespace=~\"$namespace\",source_workload=~\"$workload\"}[$__rate_interval])) by (source_workload, destination_workload, flag)","legendFormat":"TCP {{source_workload}} → {{destination_workload}} {{flag}}"}]},
    {"type":"row","title":"Cost and efficiency summary","collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":68},"panels":[]},
    {"type":"stat","title":"Known infrastructure expense","description":"Current OpenCost compute and storage rates for selected namespaces. Compute projections remain visible if storage metrics are absent; separate series make missing components explicit.","gridPos":{"h":8,"w":8,"x":0,"y":69},"fieldConfig":{"defaults":{"unit":"currencyUSD"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(node_total_hourly_cost * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\"}) > 0))","legendFormat":"Compute USD/hour"},{"refId":"B","expr":"sum(avg(pod_pvc_allocation{namespace=~\"$namespace\"}) by (persistentvolume, namespace) * on(persistentvolume) group_left() avg(pv_hourly_cost) by (persistentvolume) / 1073741824)","legendFormat":"Storage USD/hour"},{"refId":"C","expr":"24 * sum(node_total_hourly_cost * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\"}) > 0))","legendFormat":"Compute projected USD/day"},{"refId":"D","expr":"720 * sum(node_total_hourly_cost * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\"}) > 0))","legendFormat":"Compute projected USD/30 days"}]},
    {"type":"timeseries","title":"GPU cost and memory pressure","description":"Full GPU cost component for nodes hosting selected namespaces, plus aggregate DCGM utilization and framebuffer pressure.","gridPos":{"h":8,"w":8,"x":8,"y":69},"fieldConfig":{"defaults":{"min":0},"overrides":[{"matcher":{"id":"byName","options":"GPU USD/hour"},"properties":[{"id":"unit","value":"currencyUSD"}]},{"matcher":{"id":"byName","options":"GPU utilization %"},"properties":[{"id":"unit","value":"percent"}]},{"matcher":{"id":"byName","options":"GPU memory %"},"properties":[{"id":"unit","value":"percent"}]}]},"targets":[{"refId":"A","expr":"sum((avg(node_gpu_hourly_cost) by (node) * on(node) group_left() avg(node_gpu_count) by (node)) * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\"}) > 0))","legendFormat":"GPU USD/hour"},{"refId":"B","expr":"avg(DCGM_FI_DEV_GPU_UTIL{namespace=~\"$namespace\",pod=~\"$workload\"})","legendFormat":"GPU utilization %"},{"refId":"C","expr":"100 * sum(DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\",pod=~\"$workload\"}) / clamp_min(sum(DCGM_FI_DEV_FB_TOTAL{namespace=~\"$namespace\",pod=~\"$workload\"}), 1)","legendFormat":"GPU memory %"}]},
    {"type":"stat","title":"Model spend and context, previous 24h","description":"Application-reported model spend and input/output context volume. Cost accuracy depends on the runtime pricing adapter.","gridPos":{"h":8,"w":8,"x":16,"y":69},"fieldConfig":{"defaults":{"min":0},"overrides":[{"matcher":{"id":"byName","options":"Model spend USD"},"properties":[{"id":"unit","value":"currencyUSD"}]},{"matcher":{"id":"byName","options":"Effective USD/1M tokens"},"properties":[{"id":"unit","value":"currencyUSD"}]}]},"targets":[{"refId":"A","expr":"sum(increase(model_fleet_inference_cost_usd_total{namespace=~\"$namespace\",workload=~\"$workload\"}[24h]))","legendFormat":"Model spend USD"},{"refId":"B","expr":"sum(increase(model_fleet_tokens_total{namespace=~\"$namespace\",workload=~\"$workload\",direction=\"input\"}[24h]))","legendFormat":"Input context tokens"},{"refId":"C","expr":"sum(increase(model_fleet_tokens_total{namespace=~\"$namespace\",workload=~\"$workload\",direction=\"output\"}[24h]))","legendFormat":"Output tokens"},{"refId":"D","expr":"1000000 * sum(increase(model_fleet_inference_cost_usd_total{namespace=~\"$namespace\",workload=~\"$workload\"}[24h])) / clamp_min(sum(increase(model_fleet_tokens_total{namespace=~\"$namespace\",workload=~\"$workload\"}[24h])), 1)","legendFormat":"Effective USD/1M tokens"}]},
    {"type":"bargauge","title":"Cloud billed cost by service, previous 24h","description":"Itemized AWS, GCP, or other billing-export counters. Account/project billing overlaps OpenCost and is not added to its estimates.","gridPos":{"h":8,"w":12,"x":0,"y":77},"fieldConfig":{"defaults":{"unit":"currencyUSD","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (provider, service, category) (increase(model_fleet_cloud_cost_usd_total[24h]))","legendFormat":"{{provider}} · {{service}} · {{category}}","instant":true}]},
    {"type":"stat","title":"Bare-metal power and electricity","description":"Measured node power for selected workload nodes. Electricity cost requires model_fleet_electricity_usd_per_kwh; do not use it for cloud nodes or double count rates already included by OpenCost.","gridPos":{"h":8,"w":12,"x":12,"y":77},"fieldConfig":{"defaults":{"min":0},"overrides":[{"matcher":{"id":"byName","options":"Power kW"},"properties":[{"id":"unit","value":"kwatt"}]},{"matcher":{"id":"byName","options":"Electricity USD/hour"},"properties":[{"id":"unit","value":"currencyUSD"}]},{"matcher":{"id":"byName","options":"Energy kWh/day"},"properties":[{"id":"unit","value":"kwatth"}]}]},"targets":[{"refId":"A","expr":"sum(node_power_usage_watts * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$workload\"}) > 0)) / 1000","legendFormat":"Power kW"},{"refId":"B","expr":"sum(node_power_usage_watts * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$workload\"}) > 0)) / 1000 * scalar(model_fleet_electricity_usd_per_kwh)","legendFormat":"Electricity USD/hour"},{"refId":"C","expr":"24 * sum(node_power_usage_watts * on(node) group_left() (max by (node) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$workload\"}) > 0)) / 1000","legendFormat":"Energy kWh/day"}]}
  ],
  "refresh":"30s",
  "schemaVersion":39,
  "tags":["model-fleet","kubernetes","inference"],
  "templating":{"list":[
    {"name":"datasource","type":"datasource","query":"prometheus","label":"Prometheus","current":{}},
    {"name":"namespace","type":"query","datasource":"$datasource","label":"Namespace","query":{"query":"label_values(kube_pod_info, namespace)","refId":"namespace"},"definition":"label_values(kube_pod_info, namespace)","includeAll":true,"allValue":".*","multi":true,"refresh":1,"sort":1},
    {"name":"workload","type":"textbox","label":"Workload / resource regex","query":".*","current":{"text":".*","value":".*"}},
    {"name":"consumer_group","type":"query","datasource":"$datasource","label":"Kafka consumer group","query":{"query":"label_values(kafka_consumergroup_lag, consumergroup)","refId":"consumer_group"},"definition":"label_values(kafka_consumergroup_lag, consumergroup)","includeAll":true,"allValue":".*","multi":true,"refresh":2,"sort":1}
  ]},
  "time":{"from":"now-6h","to":"now"},
  "timezone":"browser",
  "title":"Model Fleet Operations",
  "uid":"model-fleet-operations",
  "version":1
}
