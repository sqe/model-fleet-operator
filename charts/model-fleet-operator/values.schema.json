{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "image", "operator", "slack", "kafka", "controlPlane", "karpenterAvailable", "serviceAccount"],
  "properties": {
    "profile": {"type": "string", "enum": ["aws", "gcp", "kind", "microk8s"]},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "nameOverride": {"type": "string"}, "fullnameOverride": {"type": "string"},
    "karpenterAvailable": {"type": "boolean"},
    "operator": {"$ref": "#/definitions/component"},
    "slack": {"allOf": [{"$ref": "#/definitions/component"}, {"type": "object", "required": ["enabled", "existingSecret", "tokenKey", "appTokenKey", "signingSecretKey", "grafanaTokenKey", "prometheusTokenKey"], "properties": {"enabled": {"type": "boolean"}, "existingSecret": {"type": "string"}, "tokenKey": {"type": "string", "minLength": 1}, "appTokenKey": {"type": "string", "minLength": 1}, "signingSecretKey": {"type": "string", "minLength": 1}, "grafanaTokenKey": {"type": "string", "minLength": 1}, "prometheusTokenKey": {"type": "string", "minLength": 1}}}]},
    "kafka": {"type": "object", "required": ["enabled", "bootstrapServers", "commandTopic", "eventTopic", "dlqTopic", "consumerGroup", "maxAttempts", "minReplicas", "maxReplicas", "pollingInterval", "cooldownPeriod", "resources", "nodeSelector", "tolerations", "affinity"], "properties": {"enabled": {"type": "boolean"}, "bootstrapServers": {"type": "string"}, "commandTopic": {"type": "string", "minLength": 1}, "eventTopic": {"type": "string", "minLength": 1}, "dlqTopic": {"type": "string", "minLength": 1}, "consumerGroup": {"type": "string", "minLength": 1}, "maxAttempts": {"type": "integer", "minimum": 1}, "triggerAuthentication": {"type": "string"}, "scalerMetadata": {"type": "object"}, "extraEnv": {"type": "array", "items": {"type": "object"}}, "minReplicas": {"type": "integer", "minimum": 0}, "maxReplicas": {"type": "integer", "minimum": 1}, "pollingInterval": {"type": "integer", "minimum": 1}, "cooldownPeriod": {"type": "integer", "minimum": 0}, "resources": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}}},
    "controlPlane": {"type": "object", "required": ["enabled", "fleetAgentEnabled", "replicas", "existingSecret", "apiKeySecretKey", "routesJson", "supervisorModel", "mlflowTrackingUri", "resources", "nodeSelector", "tolerations", "affinity", "supervisorRoute", "gatewayRoute", "fleetAgentRoute"], "properties": {"enabled": {"type": "boolean"}, "fleetAgentEnabled": {"type": "boolean"}, "replicas": {"type": "integer", "minimum": 1}, "existingSecret": {"type": "string"}, "apiKeySecretKey": {"type": "string", "minLength": 1}, "routesJson": {"type": "string"}, "supervisorModel": {"type": "string", "minLength": 1}, "mlflowTrackingUri": {"type": "string"}, "extraEnv": {"type": "array", "items": {"type": "object"}}, "resources": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "supervisorRoute": {"$ref": "#/definitions/controlRoute"}, "gatewayRoute": {"$ref": "#/definitions/controlRoute"}, "fleetAgentRoute": {"$ref": "#/definitions/controlRoute"}}},
    "gateway": {"type": "object", "additionalProperties": false, "required": ["enabled", "name", "gatewayClassName", "http", "https"], "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "minLength": 1}, "gatewayClassName": {"type": "string", "const": "cilium"}, "http": {"$ref": "#/definitions/listener"}, "https": {"allOf": [{"$ref": "#/definitions/listener"}, {"type": "object", "properties": {"certificateRefs": {"type": "array", "items": {"type": "object"}}}}]}}},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["operator", "slack"], "properties": {"operator": {"$ref": "#/definitions/serviceAccount"}, "slack": {"$ref": "#/definitions/serviceAccount"}}},
    "podSecurityContext": {"type": "object"}, "containerSecurityContext": {"type": "object"},
    "grafanaDashboard": {"type": "object", "additionalProperties": false, "required": ["enabled", "label", "labelValue", "key"], "properties": {"enabled": {"type": "boolean"}, "label": {"type": "string", "minLength": 1}, "labelValue": {"type": "string", "minLength": 1}, "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}}}
  },
  "definitions": {
    "listener": {"type": "object", "required": ["enabled", "port"], "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "controlRoute": {"type": "object", "required": ["enabled", "hostname", "sectionName"], "properties": {"enabled": {"type": "boolean"}, "hostname": {"type": "string"}, "sectionName": {"type": "string", "enum": ["http", "https"]}}},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "name", "annotations"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "component": {"type": "object", "required": ["replicaCount", "resources", "nodeSelector", "tolerations", "affinity", "podDisruptionBudget"], "properties": {"replicaCount": {"type": "integer", "minimum": 1}, "extraEnv": {"type": "array", "items": {"type": "object"}}, "resources": {"type": "object"}, "podAnnotations": {"type": "object"}, "podLabels": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "podDisruptionBudget": {"type": "object", "required": ["enabled", "minAvailable"], "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]}}}}
    }
  }
}
